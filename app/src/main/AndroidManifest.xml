<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to declare live wallpaper capability -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- Read media for Android 13+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Fallback for Android 12 and below -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Needed so the WallpaperService can persist reading the video URI -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VideoLiveWallpaper">

        <!-- ── Main launcher Activity ── -->
        <activity
            android:name=".ui.screens.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Settings Activity (launched from wallpaper picker) ── -->
        <activity
            android:name=".ui.screens.WallpaperSettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.VideoLiveWallpaper" />

        <!-- ── Live Wallpaper Service ── -->
        <service
            android:name=".service.VideoWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

    </application>
</manifest>
