<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to declare live wallpaper capability -->
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="true" />

    <!-- OpenGL ES 2.0 for hardware-accelerated video rendering & shader effects -->
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <!-- Zero storage permissions needed: SAF OpenDocument provides scoped access -->

    <application
        android:name=".VideoWallpaperApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VideoLiveWallpaper">

        <!-- Main launcher Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity (launched from system wallpaper picker) -->
        <activity
            android:name=".WallpaperSettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@style/Theme.VideoLiveWallpaper" />

        <!-- Live Wallpaper Service -->
        <service
            android:name=".service.VideoWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

        <!-- Quick Settings Tile to pause/resume live wallpaper -->
        <service
            android:name=".service.WallpaperQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_tile"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
